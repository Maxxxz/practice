#!/usr/bin/env bash
set -e

NODE_MAJOR=22

echo "当前 Node 版本: $(node -v 2>/dev/null || echo '未安装')"

# 安装 nvm（若未安装）
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ ! -s "$NVM_DIR/nvm.sh" ]; then
  curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash
fi
# shellcheck source=/dev/null
source "$NVM_DIR/nvm.sh"

nvm install "${NODE_MAJOR}" --latest-npm
nvm use "${NODE_MAJOR}"

# 全局 npm bin 加入 PATH，确保后续全局包装完可直接调用
export PATH="$(npm prefix -g)/bin:$PATH"

echo "升级后 Node 版本: $(node -v) ($(which node))"
node -v | grep -q "^v${NODE_MAJOR}\." || { echo "Node 切换失败"; exit 1; }

npm install -g codebase-memory-mcp@0.8.1

echo "codebase-memory-mcp 安装完成"
