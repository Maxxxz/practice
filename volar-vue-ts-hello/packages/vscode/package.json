{
	"private": true,
	"name": "vscode-vue-hello",
	"version": "0.0.1",
	"repository": {
		"type": "git",
		"url": "https://github.com/volarjs/starter.git",
		"directory": "packages/vscode"
	},
	"categories": [
		"Programming Languages"
	],
	"displayName": "Vue Hello Language Features",
	"description": "Vue + TypeScript language features based on Volar",
	"author": "volarjs",
	"publisher": "volarjs",
	"engines": {
		"vscode": "^1.82.0"
	},
	"activationEvents": [
		"onLanguage:vue"
	],
	"main": "./dist/client.js",
	"contributes": {
		"languages": [
			{
				"id": "vue",
				"extensions": [
					".vue"
				]
			}
		]
	},
	"scripts": {
		"build": "node scripts/build -- --minify",
		"watch": "npm run build -- --watch",
		"pack": "npm run build && vsce package --pre-release",
		"release": "npm run build && vsce publish --pre-release"
	},
	"devDependencies": {
		"@vue-hello/language-server": "workspace:*",
		"@types/vscode": "^1.82.0",
		"@volar/language-server": "~2.4.28",
		"@volar/vscode": "~2.4.28",
		"esbuild": "latest",
		"vsce": "latest"
	}
}
